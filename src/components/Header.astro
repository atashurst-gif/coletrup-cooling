---
import { mainNav } from '../data/navigation.mjs';
import { site, hasPhone, telHref } from '../lib/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (item: (typeof mainNav)[number]) =>
  item.href === current || item.children?.some((c) => c.href === current);
// Social links shown at the top right on every screen size (only the ones set in site.config)
const socialLinks = (['facebook', 'instagram'] as const)
  .filter((n) => site.socials[n])
  .map((n) => ({ name: n, url: site.socials[n], label: `${site.name} on ${n[0].toUpperCase()}${n.slice(1)}` }));
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${site.name} — home`}>
      <Logo kind="full" priority height={128} class="site-header__logo-img" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="site-nav__item has-menu">
                <a
                  href={item.href}
                  class:list={['site-nav__link', isActive(item) && 'is-active']}
                  aria-current={item.href === current ? 'page' : undefined}
                >
                  {item.short ?? item.label}
                </a>
                <button
                  type="button"
                  class="site-nav__toggle"
                  aria-expanded="false"
                  aria-controls={`menu-${item.short?.toLowerCase()}`}
                  aria-label={`${item.label} menu`}
                >
                  <Icon name="chevron" size={16} strokeWidth={2.2} />
                </button>
                <div class="site-nav__menu" id={`menu-${item.short?.toLowerCase()}`}>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={c.href === current ? 'page' : undefined}>
                          <span class="site-nav__menu-title">{c.label}</span>
                          <span class="site-nav__menu-desc">{c.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a
                  href={item.href}
                  class:list={['site-nav__link', isActive(item) && 'is-active']}
                  aria-current={item.href === current ? 'page' : undefined}
                >
                  {item.short ?? item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        socialLinks.length > 0 && (
          <ul class="site-header__social" aria-label="Social media">
            {socialLinks.map((sl) => (
              <li>
                <a href={sl.url} target="_blank" rel="noopener" data-net={sl.name} aria-label={sl.label}>
                  <Icon name={sl.name} size={16} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a href={telHref} class="site-header__phone" aria-label={hasPhone ? `Call ${site.contact.phoneDisplay}` : 'Call us'} data-track="cta" data-cta="phone" data-location="header">
        <Icon name="phone" size={18} strokeWidth={2} />
        <span>{hasPhone ? site.contact.phoneDisplay : 'Call us'}</span>
      </a>
      <Button href="/contact/#quote" size="sm" icon={null} track="quote" data-location="header" class="site-header__quote">
        Get a quote
      </Button>
      <button
        type="button"
        class="site-header__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        id="burger"
      >
        <Icon name="menu" strokeWidth={2} />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 240, 0.86);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .site-header.is-stuck {
    border-color: var(--line);
    background: rgba(250, 247, 240, 0.94);
    box-shadow: 0 10px 30px -22px rgba(7, 45, 82, 0.35);
  }
  .site-header__inner {
    width: min(100% - 2 * var(--gutter), 1520px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    transition: min-height 0.3s var(--ease);
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    text-decoration: none;
    border-radius: 6px;
  }
  .site-header__logo :global(.site-header__logo-img) {
    height: 74px !important;
    transition: height 0.3s var(--ease);
  }
  @media (min-width: 640px) {
    .site-header__logo :global(.site-header__logo-img) {
      height: 92px !important;
    }
  }
  @media (min-width: 1080px) {
    .site-header__logo :global(.site-header__logo-img) {
      height: 108px !important;
    }
    .site-header.is-stuck .site-header__inner {
      min-height: calc(var(--header-h) - 28px);
    }
    .site-header.is-stuck .site-header__logo :global(.site-header__logo-img) {
      height: 84px !important;
    }
  }
  @media (min-width: 1280px) {
    .site-header__logo :global(.site-header__logo-img) {
      height: 128px !important;
    }
    .site-header.is-stuck .site-header__inner {
      min-height: calc(var(--header-h) - 40px);
    }
    .site-header.is-stuck .site-header__logo :global(.site-header__logo-img) {
      height: 96px !important;
    }
  }
  .site-nav {
    display: none;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Social icons, in each network's own colours */
  .site-header__social {
    --soc: 30px;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0.1rem 0 0;
    padding: 0;
  }
  .site-header__social a {
    display: grid;
    place-items: center;
    width: var(--soc);
    height: var(--soc);
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .site-header__social a:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 16px -10px rgba(7, 45, 82, 0.7);
  }
  .site-header__social a[data-net='facebook'] {
    background: #1877f2;
  }
  .site-header__social a[data-net='instagram'] {
    border-radius: 32%;
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
  }
  @media (min-width: 640px) {
    .site-header__social {
      --soc: 32px;
    }
  }
  /* Narrowest desktop row: slightly smaller icons and gaps so everything stays on one line */
  @media (min-width: 1080px) and (max-width: 1279px) {
    .site-header__inner {
      gap: 0.6rem;
    }
    .site-header__social {
      --soc: 28px;
      gap: 0.3rem;
    }
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.6rem;
    border-radius: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__phone span {
    display: none;
  }
  .site-header__phone:hover {
    background: rgba(7, 45, 82, 0.06);
  }
  .site-header__quote {
    display: none;
  }
  .site-header__burger {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: var(--navy);
  }

  @media (min-width: 640px) {
    .site-header__quote {
      display: inline-flex;
    }
  }
  @media (min-width: 640px) and (max-width: 1079px) {
    .site-header__phone span {
      display: inline;
    }
  }
  @media (min-width: 1360px) {
    .site-header__phone span {
      display: inline;
    }
  }

  @media (min-width: 1080px) {
    .site-nav {
      display: block;
      flex: 1 1 auto;
      min-width: 0;
    }
    .site-header__burger {
      display: none;
    }
    .site-nav__list {
      display: flex;
      justify-content: center;
      gap: 0.1rem;
      list-style: none;
    }
    .site-nav__item {
      position: relative;
      display: flex;
      align-items: center;
    }
    .site-nav__link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.3rem;
      border-radius: 10px;
      font-family: var(--font-head);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--navy);
      text-decoration: none;
      letter-spacing: -0.01em;
      white-space: nowrap;
      transition: background-color 0.2s ease;
    }
    .has-menu .site-nav__link {
      padding-right: 1.5rem;
    }
    .site-nav__link:hover,
    .site-nav__item:hover .site-nav__link {
      background: rgba(7, 45, 82, 0.06);
    }
    .site-nav__link.is-active {
      box-shadow: inset 0 -2px 0 var(--orange);
      border-radius: 10px 10px 0 0;
    }
    .site-nav__toggle {
      position: absolute;
      right: 0.05rem;
      top: 50%;
      transform: translateY(-50%);
      display: inline-grid;
      place-items: center;
      width: 24px;
      height: 36px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: var(--navy);
    }
    .site-nav__toggle svg {
      transition: transform 0.25s var(--ease);
    }
    .site-nav__toggle[aria-expanded='true'] svg,
    .site-nav__item:hover .site-nav__toggle svg {
      transform: rotate(180deg);
    }
    .site-nav__menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      z-index: 5;
      min-width: 320px;
      padding: 0.5rem;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      transform: translate(-50%, 8px);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.22s var(--ease),
        transform 0.22s var(--ease),
        visibility 0s linear 0.22s;
    }
    .site-nav__menu::before {
      /* hover bridge */
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -12px;
      height: 12px;
    }
    .site-nav__item:hover .site-nav__menu,
    .site-nav__item:focus-within .site-nav__menu,
    .site-nav__toggle[aria-expanded='true'] + .site-nav__menu {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition-delay: 0s;
    }
    .site-nav__menu ul {
      list-style: none;
    }
    .site-nav__menu a {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.7rem 0.85rem;
      border-radius: 10px;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }
    .site-nav__menu a:hover,
    .site-nav__menu a[aria-current='page'] {
      background: var(--cream);
    }
    .site-nav__menu-title {
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9375rem;
      color: var(--navy);
    }
    .site-nav__menu-desc {
      font-size: 0.8125rem;
      color: var(--muted);
    }
  }
  @media (min-width: 1080px) and (max-width: 1279px) {
    .site-header__quote {
      padding-inline: 0.85rem;
    }
  }
  @media (min-width: 1280px) {
    .site-nav__link {
      padding: 0 0.5rem;
      font-size: 0.84375rem;
    }
    .has-menu .site-nav__link {
      padding-right: 1.6rem;
    }
  }
  @media (min-width: 1360px) {
    .site-nav__link {
      padding: 0 0.6rem;
      font-size: 0.875rem;
    }
    .has-menu .site-nav__link {
      padding-right: 1.65rem;
    }
  }
  @media (min-width: 1500px) {
    .site-nav__link {
      padding: 0 0.75rem;
      font-size: 0.9rem;
    }
    .has-menu .site-nav__link {
      padding-right: 1.75rem;
    }
  }
  @media (min-width: 1600px) {
    .site-nav__link {
      padding: 0 0.85rem;
      font-size: 0.9375rem;
    }
    .has-menu .site-nav__link {
      padding-right: 1.9rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Keyboard / touch access for desktop dropdowns
  const toggles = document.querySelectorAll<HTMLButtonElement>('.site-nav__toggle');
  const closeAll = (except?: HTMLButtonElement) =>
    toggles.forEach((t) => t !== except && t.setAttribute('aria-expanded', 'false'));
  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll());
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-menu')) closeAll();
  });
</script>
