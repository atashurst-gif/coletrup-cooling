---
/**
 * Persistent conversion bar.
 * Desktop: prompt + GET A QUOTE + WHATSAPP NOW. Mobile: two equal buttons.
 * Shows only once the visitor has been on the site for 20 seconds (counted across
 * pages), and stays out of the way at the top of a page and whenever a CTA is on
 * screen (hero, mid-page band, quote form, closing band, footer — anything marked
 * data-hide-lead-bar). Space is reserved at the bottom of <main> (--bar-space) so it
 * never covers form buttons or content; the cookie banner stacks above it.
 */
import Button from './Button.astro';
import { whatsappHref } from '../lib/site';

export interface Props {
  prompt?: string;
  whatsappMessage?: string;
}
const { prompt = 'Need air conditioning support?', whatsappMessage } = Astro.props;
---

<div class="lead-bar is-hidden" id="lead-bar" role="region" aria-label="Get in touch" data-delay="20000">
  <div class="container-wide lead-bar__inner">
    <p class="lead-bar__prompt">{prompt}</p>
    <div class="lead-bar__actions">
      <Button href="/contact/#quote" icon={null} track="quote" data-location="sticky-bar" class="lead-bar__btn">
        Get a quote
      </Button>
      <Button href={whatsappHref(whatsappMessage)} variant="light" icon="chat" whatsapp track="whatsapp" data-location="sticky-bar" class="lead-bar__btn">
        WhatsApp now
      </Button>
    </div>
  </div>
</div>

<style>
  .lead-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: rgba(7, 45, 82, 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -12px 40px -20px rgba(3, 24, 45, 0.6);
    transform: translateY(0);
    transition: transform 0.35s var(--ease);
  }
  .lead-bar.is-hidden {
    transform: translateY(110%);
  }
  .lead-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 78px;
    padding-block: 12px;
  }
  .lead-bar__prompt {
    display: none;
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.0625rem;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .lead-bar__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }
  .lead-bar__btn {
    padding-inline: 0.75rem;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  @media (max-width: 430px) {
    .lead-bar__btn {
      padding-inline: 0.5rem;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }
  }
  @media (min-width: 900px) {
    .lead-bar__inner {
      min-height: 84px;
    }
    .lead-bar__prompt {
      display: block;
    }
    .lead-bar__actions {
      width: auto;
      grid-template-columns: auto auto;
      gap: 12px;
    }
    .lead-bar__btn {
      padding-inline: 1.5rem;
      font-size: 0.875rem;
    }
  }
  @media (min-width: 900px) {
    .lead-bar {
      /* On desktop, float the bar as a pill for a more premium feel */
      left: 50%;
      right: auto;
      bottom: 16px;
      width: min(calc(100% - 2 * var(--gutter)), var(--container-wide));
      transform: translateX(-50%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      padding-bottom: 0;
      box-shadow: 0 30px 60px -28px rgba(3, 24, 45, 0.7);
    }
    .lead-bar.is-hidden {
      transform: translate(-50%, 140%);
    }
    .lead-bar__inner {
      width: 100%;
      padding-inline: 20px 12px;
    }
  }
</style>

<script>
  // Show only after 20s on the site (across pages), never at the top of a page, and
  // never while a CTA (anything marked data-hide-lead-bar) is on screen.
  const bar = document.getElementById('lead-bar');
  if (bar) {
    const DELAY = Number(bar.dataset.delay) || 20000;
    const KEY = 'cc-first-seen';
    let first = 0;
    try {
      first = Number(sessionStorage.getItem(KEY)) || 0;
      if (!first) {
        first = Date.now();
        sessionStorage.setItem(KEY, String(first));
      }
    } catch {
      first = Date.now();
    }
    let ready = false;
    let atTop = true;
    const nearCta = new Set<Element>();
    const update = () => bar.classList.toggle('is-hidden', !ready || atTop || nearCta.size > 0);

    window.setTimeout(() => {
      ready = true;
      update();
    }, Math.max(0, DELAY - (Date.now() - first)));

    const checkTop = () => {
      const top = window.scrollY < Math.min(window.innerHeight * 0.6, 480);
      if (top !== atTop) {
        atTop = top;
        update();
      }
    };
    checkTop();
    window.addEventListener('scroll', checkTop, { passive: true });

    const watch = document.querySelectorAll('[data-hide-lead-bar]');
    if (watch.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? nearCta.add(e.target) : nearCta.delete(e.target)));
          update();
        },
        { threshold: 0.05 },
      );
      watch.forEach((el) => io.observe(el));
    }
  }
</script>
