---
/**
 * Before & after gallery — pairs of job photos shown side by side with "Before" and
 * "After" labels, plus optional single photos. The two photos of a pair stay next to
 * each other on phones too, so the comparison is always visible.
 */
import { Picture } from 'astro:assets';
import { images, type ImageKey } from '../lib/images';

export interface Props {
  id?: string;
  tone?: 'cream' | 'white' | 'sand';
  eyebrow?: string;
  title: string;
  intro?: string;
  /** A pair (before + after) or a single photo (image). */
  items: { before?: ImageKey; after?: ImageKey; image?: ImageKey; caption: string; position?: string; beforePosition?: string; afterPosition?: string }[];
}
const { id, tone = 'cream', eyebrow = 'Before & after', title, intro, items } = Astro.props;
---

<section class:list={['section', 'ba', `tone-${tone}`]} id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container">
    <div class:list={['section-head', intro ? 'section-head--split' : '']}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={id ? `${id}-title` : undefined}>{title}</h2>
      </div>
      {intro && <p>{intro}</p>}
    </div>
    <ul class="ba__grid">
      {
        items.map((it, i) => (
          <li class="ba__card" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <figure>
              {it.before && it.after ? (
                <div class="ba__pair">
                  <div class="frame ba__shot">
                    <Picture src={images[it.before].src} alt={images[it.before].alt} widths={[240, 400, 640]} sizes="(min-width: 900px) 300px, 46vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={78} style={it.beforePosition ? `object-position:${it.beforePosition}` : undefined} />
                    <span class="ba__tag">Before</span>
                  </div>
                  <div class="frame ba__shot">
                    <Picture src={images[it.after].src} alt={images[it.after].alt} widths={[240, 400, 640]} sizes="(min-width: 900px) 300px, 46vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={78} style={it.afterPosition ? `object-position:${it.afterPosition}` : undefined} />
                    <span class="ba__tag ba__tag--after">After</span>
                  </div>
                </div>
              ) : (
                it.image && (
                  <div class="ba__pair ba__pair--single">
                    <div class="frame ba__shot">
                      <Picture src={images[it.image].src} alt={images[it.image].alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 610px, 92vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={78} style={it.position ? `object-position:${it.position}` : undefined} />
                    </div>
                  </div>
                )
              )}
              <figcaption class="ba__cap">{it.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ba__grid {
    list-style: none;
    display: grid;
    gap: 2rem 1.5rem;
  }
  .ba__card figure {
    margin: 0;
  }
  .ba__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    aspect-ratio: 3 / 2;
  }
  .ba__pair--single {
    grid-template-columns: minmax(0, 1fr);
  }
  .ba__shot {
    height: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .ba__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(7, 45, 82, 0.18);
  }
  .ba__tag--after {
    background: var(--orange);
  }
  .ba__cap {
    margin-top: 0.85rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
  }
  .ba__cap::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 2px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--orange);
  }
  @media (min-width: 900px) {
    .ba__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
    .ba__pair {
      gap: 10px;
    }
  }
</style>
