---
/**
 * Section 10 — Trust. Genuine reviews and accreditations from site.config only.
 * With nothing supplied, renders clearly marked CMS placeholders.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { images, type ImageKey } from '../lib/images';
import { site } from '../lib/site';

export interface Props {
  /** Photo (or decorative graphic) for the aside — each page passes a different one. */
  image?: ImageKey;
  /** false = reviews only (no photo / accreditations column). */
  aside?: boolean;
}
const { image = 'van', aside: showAside = true } = Astro.props;
const reviews = site.reviews as any[];
// 4+ reviews: a slow moving row that pauses when hovered, touched or focused.
const moving = reviews.length >= 4;
const accreditations = site.accreditations;
const aside = images[image];
---

<section class="section trust tone-white" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Trusted by homes and businesses</p>
      <h2 id="trust-title">Real homes. Real businesses. Professional service.</h2>
    </div>

    <div class:list={['trust__grid', !showAside && 'trust__grid--solo']}>
      <div class="trust__reviews">
        {
          reviews.length > 0 ? (
            moving ? (
              <div class="trust__marquee">
                <ul class="trust__track">
                  {[...reviews, ...reviews].map((r, i) => (
                    <li class="card trust__card" aria-hidden={i >= reviews.length ? 'true' : undefined}>
                  {r.stars && <p class="trust__stars" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}</p>}
                  <blockquote class="trust__text">
                    {String(r.quote).split('\n\n').map((para) => <p>{para}</p>)}
                  </blockquote>
                  <p class="trust__by">
                    <strong>{r.name}</strong>
                    {r.location && <span> · {r.location}</span>}
                    {r.service && <span class="trust__svc">{r.service}</span>}
                  </p>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
            <ul class:list={['trust__list', reviews.length === 1 && 'trust__list--one']}>
              {reviews.slice(0, 3).map((r) => (
                <li class="card trust__card" data-reveal>
                  {r.stars && <p class="trust__stars" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}</p>}
                  <blockquote class="trust__text">
                    {String(r.quote).split('\n\n').map((para) => <p>{para}</p>)}
                  </blockquote>
                  <p class="trust__by">
                    <strong>{r.name}</strong>
                    {r.location && <span> · {r.location}</span>}
                    {r.service && <span class="trust__svc">{r.service}</span>}
                  </p>
                </li>
              ))}
            </ul>
            )
          ) : (
            <ul class="trust__list">
              {[0, 1, 2].map((i) => (
                <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
                  <Placeholder block label="GENUINE CUSTOMER REVIEW TO BE ADDED">
                    <p>Customer name, location and the review source (e.g. Google) to be inserted from verified feedback only. Edit <code>reviews</code> in <code>site.config.mjs</code>.</p>
                  </Placeholder>
                </li>
              ))}
            </ul>
          )
        }
        {
          site.reviewProfile && (
            <p class="trust__more">
              <a href={site.reviewProfile.url} class="link-arrow" target="_blank" rel="noopener">
                <span>Read our reviews on {site.reviewProfile.label}</span>
                <Icon name="external" />
              </a>
            </p>
          )
        }
      </div>

      {showAside && (
      <aside class="trust__aside" data-reveal style="--reveal-delay:200ms">
        <div class="frame trust__van">
          <Picture src={aside.src} alt={aside.alt} title={aside.title} widths={[480, 800, 1200]} sizes="(min-width: 1080px) 34vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={80} />
        </div>
        <div class="trust__acc">
          <h3 class="trust__acc-title">Accreditations &amp; memberships</h3>
          {
            accreditations.length > 0 ? (
              <ul class="trust__acc-list">
                {accreditations.map((a) => (
                  <li class:list={[a.logo && 'trust__acc-logo']}>
                    {a.logo ? (
                      <img src={a.logo} alt={a.name} loading="lazy" width={a.width} height={a.height} />
                    ) : (
                      <>
                        <Icon name="award" />
                        <span>
                          {a.name}
                          {a.number && <small> · {a.number}</small>}
                        </span>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <Placeholder block label="VERIFIED ACCREDITATIONS TO BE ADDED">
                <p>Only accreditations currently held (with certificate numbers where relevant) should be listed here. Edit <code>accreditations</code> in <code>site.config.mjs</code>.</p>
              </Placeholder>
            )
          }
        </div>
      </aside>
      )}
    </div>
  </div>
</section>

<style>
  .trust__grid {
    display: grid;
    gap: 2.5rem;
  }
  .trust__list {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .trust__stars {
    margin: 0 0 0.6rem;
    color: var(--orange);
    letter-spacing: 0.15em;
    font-size: 1.1rem;
  }
  .trust__list--one {
    max-width: 46rem;
    margin-inline: auto;
    grid-template-columns: 1fr !important;
  }
  .trust__marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .trust__track {
    list-style: none;
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: trust-move 60s linear infinite;
  }
  .trust__track .trust__card {
    width: min(82vw, 24rem);
    flex: none;
  }
  .trust__marquee:hover .trust__track,
  .trust__marquee:active .trust__track,
  .trust__marquee:focus-within .trust__track {
    animation-play-state: paused;
  }
  @keyframes trust-move {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust__marquee {
      overflow-x: auto;
    }
    .trust__track {
      animation: none;
    }
  }
  .trust__card {
    padding: 1.6rem;
    border-radius: var(--radius);
  }
  .trust__quote {
    color: var(--blue);
    margin-bottom: 0.75rem;
  }
  .trust__text {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
    color: var(--charcoal);
  }
  .trust__by {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .trust__by strong {
    color: var(--navy);
  }
  .trust__svc,
  .trust__src {
    display: block;
    font-size: 0.8125rem;
  }
  .trust__more {
    margin-top: 1.25rem;
  }
  .trust__van {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
  }
  .trust__van :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .trust__acc {
    margin-top: 1.25rem;
  }
  .trust__acc-title {
    margin-bottom: 0.9rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .trust__acc-list {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .trust__acc-list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--navy);
  }
  .trust__acc-list li {
    background: #fff;
  }
  .trust__acc-list {
    display: flex;
    flex-wrap: wrap;
  }
  .trust__acc-list li.trust__acc-logo {
    justify-content: center;
    flex: 1 1 130px;
    padding: 0.9rem 1.1rem;
  }
  .trust__acc-list :global(img) {
    display: block;
    height: 44px;
    width: auto;
  }
  .trust__acc-list small {
    color: var(--muted);
    font-weight: 400;
  }
  code {
    font-size: 0.85em;
    background: rgba(7, 45, 82, 0.06);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
  @media (min-width: 1080px) {
    .trust__grid--solo .trust__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .trust__grid:not(.trust__grid--solo) {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }
</style>
