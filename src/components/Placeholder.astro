---
/**
 * Clearly marked placeholder for VERIFIED content that has not been supplied.
 * Inline: <Placeholder label="PHONE NUMBER" />
 * Block:  <Placeholder block label="GENUINE CUSTOMER REVIEW TO BE ADDED">…</Placeholder>
 */
export interface Props {
  label: string;
  block?: boolean;
  class?: string;
}
const { label, block = false, class: className } = Astro.props;
---

{
  block ? (
    <div class:list={['ph-block', className]} data-placeholder={label}>
      <span class="ph-block__label">[{label}]</span>
      <slot />
    </div>
  ) : (
    <span class:list={['ph', className]} data-placeholder={label}>[{label}]</span>
  )
}
