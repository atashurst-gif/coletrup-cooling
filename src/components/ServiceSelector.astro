---
/**
 * Homepage Section 2 — "What can we help you with?"
 * Three premium navigation cards. Residential gets the strongest emphasis.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { images } from '../lib/images';

const cards = [
  {
    key: 'residential',
    title: 'Residential Air Conditioning',
    text: 'Professional installation, servicing and repairs for homes.',
    cta: 'Explore Residential',
    href: '/residential-air-conditioning/',
    image: images.engineerHome,
    position: '55% 40%',
    icon: 'home',
    tag: 'Our main focus',
  },
  {
    key: 'commercial',
    title: 'Commercial Air Conditioning',
    text: 'Reliable installation, servicing and repairs for businesses.',
    cta: 'Explore Commercial',
    href: '/commercial-air-conditioning/',
    image: images.officeBoardroom,
    position: '55% 35%',
    icon: 'building',
  },
  {
    key: 'refrigeration',
    title: 'Refrigeration',
    text: 'Specialist servicing, maintenance and repairs.',
    cta: 'Explore Refrigeration',
    href: '/refrigeration-repairs-maintenance/',
    image: images.supermarketChillers,
    position: '65% 50%',
    icon: 'fridge',
  },
];
---

<section class="section selector" id="services" aria-labelledby="selector-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Our services</p>
      <h2 id="selector-title">What can we help you with?</h2>
    </div>
    <div class="selector__grid">
      {
        cards.map((c, i) => (
          <article class:list={['sel', `sel--${c.key}`, 'zoom']} data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="frame sel__media">
              <Picture
                src={c.image.src}
                alt={c.image.alt}
                title={c.image.title}
                widths={[480, 800, 1200]}
                sizes={c.key === 'residential' ? '(min-width: 1080px) 60vw, 100vw' : '(min-width: 1080px) 40vw, 100vw'}
                formats={['avif', 'webp']} fallbackFormat="webp"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                quality={80}
                style={`object-position:${c.position}`}
              />
            </div>
            <div class="sel__body">
              {c.tag && <span class="sel__tag">{c.tag}</span>}
              <span class="icon-badge sel__icon"><Icon name={c.icon} /></span>
              <h3 class="sel__title">
                <a href={c.href} class="stretched" data-track="cta" data-cta={c.key} data-location="service-selector">
                  {c.title}
                </a>
              </h3>
              <p class="sel__text">{c.text}</p>
              <span class="link-arrow sel__cta" aria-hidden="true">
                <span>{c.cta}</span>
                <Icon name="arrow" strokeWidth={2} />
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .selector__grid {
    display: grid;
    gap: 1.25rem;
  }
  .sel {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .sel:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .sel__media {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .sel__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sel__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.5rem;
  }
  .sel__tag {
    position: absolute;
    top: -16px;
    right: 1.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--orange);
    color: var(--navy);
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 18px -8px rgba(245, 117, 0, 0.8);
  }
  .sel__icon {
    margin-bottom: 0.2rem;
  }
  .sel__title {
    font-size: 1.35rem;
  }
  .sel__title a {
    text-decoration: none;
    color: inherit;
  }
  .sel__text {
    color: var(--muted);
  }
  .sel__cta {
    margin-top: 0.4rem;
  }
  .sel--residential {
    border-color: rgba(7, 45, 82, 0.2);
    box-shadow: var(--shadow-md);
  }
  .sel--residential .sel__title {
    font-size: 1.6rem;
  }
  @media (min-width: 700px) {
    .selector__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sel--residential {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }
    .sel--residential .sel__media {
      aspect-ratio: auto;
      min-height: 320px;
    }
    .sel--residential .sel__body {
      justify-content: center;
      padding: 2.25rem;
    }
    .sel--residential .sel__tag {
      top: 1.5rem;
      right: 1.5rem;
    }
  }
  @media (min-width: 1080px) {
    .selector__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
    .sel--residential {
      grid-column: span 3;
      grid-row: span 2;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
    }
    .sel--residential .sel__media {
      min-height: 0;
      aspect-ratio: auto;
    }
    .sel--residential .sel__body {
      padding: 2rem 2.25rem 2.25rem;
    }
    .sel--residential .sel__title {
      font-size: 1.85rem;
    }
    .sel--commercial,
    .sel--refrigeration {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
    }
    .sel--commercial .sel__media,
    .sel--refrigeration .sel__media {
      aspect-ratio: auto;
      min-height: 0;
    }
    .sel--commercial .sel__body,
    .sel--refrigeration .sel__body {
      justify-content: center;
      padding: 1.5rem 1.6rem;
    }
    .sel--commercial .sel__title,
    .sel--refrigeration .sel__title {
      font-size: 1.2rem;
    }
    .sel--commercial .sel__text,
    .sel--refrigeration .sel__text {
      font-size: var(--fs-sm);
    }
  }
</style>
