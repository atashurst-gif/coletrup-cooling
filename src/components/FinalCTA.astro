---
/**
 * Final CTA band — branded airflow graphic background, GET A QUOTE + WHATSAPP NOW.
 */
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Airflow from './Airflow.astro';
import { images } from '../lib/images';
import { whatsappHref } from '../lib/site';

export interface Props {
  id?: string;
  title?: string;
  text?: string;
  whatsappMessage?: string;
  quoteHref?: string;
  quoteLabel?: string;
}
const {
  id = 'final-cta',
  title = 'Need air conditioning support?',
  text = "Tell us what you need and we'll take it from there.",
  whatsappMessage,
  quoteHref = '/contact/#quote',
  quoteLabel = 'Get a quote',
} = Astro.props;
const bg = images.airflow;
---

<section class="section fcta on-dark" id={id} aria-labelledby={`${id}-title`} data-hide-lead-bar>
  <div class="fcta__bg" aria-hidden="true">
    <Picture src={bg.src} alt="" widths={[800, 1400]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={70} />
  </div>
  <Airflow tone="dark" lines={6} seed={3} intensity={0.55} />
  <div class="container fcta__inner" data-reveal>
    <h2 id={`${id}-title`} class="fcta__title">{title}</h2>
    <p class="fcta__text">{text}</p>
    <div class="fcta__actions">
      <Button href={quoteHref} size="lg" icon={null} track="quote" data-location={id}>{quoteLabel}</Button>
      <Button href={whatsappHref(whatsappMessage)} variant="light" size="lg" icon="chat" whatsapp track="whatsapp" data-location={id}>
        WhatsApp now
      </Button>
    </div>
  </div>
</section>

<style>
  .fcta {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
    color: #fff;
    text-align: center;
  }
  .fcta__bg {
    position: absolute;
    inset: 0;
  }
  .fcta__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    filter: blur(2px) saturate(1.1);
    transform: scale(1.03);
  }
  .fcta__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 20% 100%, rgba(245, 117, 0, 0.16), transparent 70%),
      radial-gradient(50% 70% at 85% 0%, rgba(0, 154, 224, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(5, 33, 61, 0.6), rgba(5, 33, 61, 0.78));
  }
  .fcta__inner {
    position: relative;
  }
  .fcta__title {
    color: #fff;
    font-size: var(--fs-h2);
  }
  .fcta__text {
    margin: 1rem auto 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    color: rgba(255, 255, 255, 0.82);
  }
  .fcta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2rem;
  }
</style>
