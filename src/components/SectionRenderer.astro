---
/**
 * Renders a service page's `sections[]` from src/data/services.mjs.
 * Types: intro | features | links | split | steps | duo | callout | checklist
 */
import Icon from './Icon.astro';
import FeatureSection from './FeatureSection.astro';
import ServiceCards from './ServiceCards.astro';
import ImageTextSection from './ImageTextSection.astro';
import ProcessSteps from './ProcessSteps.astro';
import JobGallery from './JobGallery.astro';
import MidCTA from './MidCTA.astro';
import { Picture } from 'astro:assets';
import { images } from '../lib/images';

export interface Props {
  sections: any[];
  slug: string;
  /** Render the mid-page CTA band after this section index (defaults to the middle section). */
  midCta?: { after?: number; quoteHref?: string; quoteLabel?: string; whatsappMessage?: string; title?: string; text?: string } | false;
}
const { sections, slug, midCta = {} } = Astro.props;
const toneOf = (s: any): 'cream' | 'white' | 'sand' => (s.tone === 'white' || s.tone === 'sand' ? s.tone : 'cream');
// Middle section by default; step off a navy section so the band's background matches the section above it.
const mid = Math.max(0, Math.ceil(sections.length / 2) - 1);
const midAfter =
  midCta === false ? -1 : (midCta.after ?? [mid, mid - 1, mid + 1].find((i) => i >= 0 && i < sections.length && sections[i]?.tone !== 'navy') ?? mid);
---

{
  sections.map((s, i) => {
    const id = `${slug}-s${i + 1}`;
    const node = (() => {
    switch (s.type) {
      case 'intro':
        return (
          <section class:list={['section', 'intro', `tone-${s.tone ?? 'cream'}`]} id={id} aria-labelledby={`${id}-title`}>
            <div class="container intro__grid">
              <div data-reveal>
                <p class="eyebrow">{s.eyebrow}</p>
                <h2 id={`${id}-title`}>{s.title}</h2>
                {s.body.map((p: string, j: number) => <p class:list={['intro__p', j === 0 && 'lead']}>{p}</p>)}
              </div>
              {s.aside && (
                <aside class="intro__aside card" data-reveal style="--reveal-delay:120ms">
                  <h3 class="intro__aside-title">{s.aside.title}</h3>
                  <ul class="intro__aside-list">
                    {s.aside.items.map((it: any) => (
                      <li>
                        <span class="icon-badge"><Icon name={it.icon} /></span>
                        <div>
                          <strong>{it.title}</strong>
                          <p>{it.text}</p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </aside>
              )}
            </div>
          </section>
        );
      case 'features':
        return <FeatureSection id={id} tone={s.tone} variant={s.variant} eyebrow={s.eyebrow} title={s.title} intro={s.intro} note={s.note} items={s.items} />;
      case 'checklist':
        return <FeatureSection id={id} tone={s.tone} variant="list" eyebrow={s.eyebrow} title={s.title} intro={s.intro} note={s.note} items={s.items} />;
      case 'links':
        return <ServiceCards id={id} tone={s.tone ?? 'cream'} eyebrow={s.eyebrow} title={s.title} intro={s.intro} items={s.items} />;
      case 'split':
        return (
          <ImageTextSection
            id={id}
            tone={s.tone ?? 'cream'}
            image={s.image}
            icon={s.icon}
            panelSeed={s.panelSeed ?? 40 + i * 7}
            imagePosition={s.imagePosition}
            imageSide={s.imageSide ?? 'right'}
            eyebrow={s.eyebrow}
            title={s.title}
            body={s.body}
            bullets={s.bullets}
            links={s.links}
            cta={s.cta}
          />
        );
      case 'gallery':
        return <JobGallery id={id} tone={s.tone ?? 'cream'} eyebrow={s.eyebrow} title={s.title} intro={s.intro} items={s.items} />;
      case 'steps':
        return <ProcessSteps id={id} tone={s.tone ?? 'cream'} eyebrow={s.eyebrow} title={s.title} steps={s.items} />;
      case 'duo':
        return (
          <section class:list={['section', 'duo', `tone-${s.tone ?? 'cream'}`]} id={id} aria-labelledby={`${id}-title`}>
            <div class="container">
              <div class="section-head">
                <p class="eyebrow">{s.eyebrow}</p>
                <h2 id={`${id}-title`}>{s.title}</h2>
              </div>
              <div class="duo__grid">
                {s.items.map((it: any, j: number) => (
                  <article class:list={['card', 'card--lift', 'duo__card', it.image && 'duo__card--photo', it.image && 'zoom']} data-reveal style={`--reveal-delay:${j * 100}ms`}>
                    {it.image && (
                      <div class="frame duo__media">
                        <Picture src={images[it.image].src} alt={images[it.image].alt} title={images[it.image].title} widths={[480, 800, 1200]} sizes="(min-width: 1080px) 46vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={78} />
                      </div>
                    )}
                    <div class="duo__body">
                    <span class="icon-badge duo__icon"><Icon name={it.icon} /></span>
                    <p class="duo__eyebrow">{it.eyebrow}</p>
                    <h3 class="duo__title">
                      <a href={it.href} class="stretched" data-track={it.track ? 'cta' : undefined} data-cta={it.track} data-location={id}>{it.title}</a>
                    </h3>
                    <p class="duo__text">{it.text}</p>
                    <span class="link-arrow" aria-hidden="true"><span>{it.linkLabel}</span><Icon name="arrow" strokeWidth={2} /></span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      case 'callout':
        return (
          <section class:list={['section', 'section--tight', `tone-${s.tone ?? 'cream'}`]} id={id} aria-labelledby={`${id}-title`}>
            <div class="container">
              <div class="callout" data-reveal>
                <span class="icon-badge callout__icon"><Icon name={s.icon ?? 'clipboard'} /></span>
                <div>
                  <h2 id={`${id}-title`} class="callout__title">{s.title}</h2>
                  {s.intro && <p class="callout__intro">{s.intro}</p>}
                  <ul class="ticks callout__list">
                    {s.items.map((it: string) => <li>{it}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </section>
        );
      default:
        return null;
    }
    })();
    return (
      <>
        {node}
        {i === midAfter && midCta !== false && (
          <MidCTA id={`${slug}-mid-cta`} tone={toneOf(s)} quoteHref={midCta.quoteHref} quoteLabel={midCta.quoteLabel} whatsappMessage={midCta.whatsappMessage} title={midCta.title} text={midCta.text} />
        )}
      </>
    );
  })
}

<style>
  .intro__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .intro__p {
    max-width: 60ch;
    color: var(--muted);
  }
  .intro__p.lead {
    margin-top: 1rem;
    color: var(--charcoal);
  }
  .intro__aside {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
  }
  .intro__aside-title {
    margin-bottom: 1.1rem;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .intro__aside-list {
    list-style: none;
    display: grid;
    gap: 1.1rem;
  }
  .intro__aside-list li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .intro__aside-list strong {
    display: block;
    font-family: var(--font-head);
    color: var(--navy);
    margin-bottom: 0.15rem;
  }
  .intro__aside-list p {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .duo__grid {
    display: grid;
    gap: 1.25rem;
  }
  .duo__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .duo__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem;
    flex: 1;
  }
  .duo__media {
    border-radius: 0;
    aspect-ratio: 16 / 9;
  }
  .duo__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .duo__card--photo .duo__icon {
    position: relative;
    z-index: 2; /* sits over the photo frame */
    margin-top: -3.25rem;
    background: var(--navy);
    color: var(--blue-on-navy);
    box-shadow: 0 0 0 5px #fff;
  }
  .duo__icon {
    margin-bottom: 0.5rem;
  }
  .duo__eyebrow {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-ink);
  }
  .duo__title {
    font-size: 1.35rem;
  }
  .duo__title a {
    color: inherit;
    text-decoration: none;
  }
  .duo__text {
    color: var(--muted);
  }
  .duo__card .link-arrow {
    margin-top: 0.5rem;
  }
  .callout {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--orange);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .tone-white .callout {
    background: var(--cream);
  }
  .callout__title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }
  .callout__intro {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .callout__list {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  @media (min-width: 640px) {
    .duo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: 4rem;
    }
  }
</style>
