---
/**
 * "On the job" gallery — real photos from site. A swipeable slide on phones,
 * a neat row on larger screens. Each photo carries a short caption.
 */
import { Picture } from 'astro:assets';
import { images, type ImageKey } from '../lib/images';

export interface Props {
  id?: string;
  tone?: 'cream' | 'white' | 'sand';
  eyebrow?: string;
  title?: string;
  intro?: string;
  items: { image: ImageKey; caption?: string }[];
}
const { id, tone = 'cream', eyebrow = 'On the job', title = 'Real work, carried out properly.', intro, items } = Astro.props;
---

<section class:list={['section', 'jobs', `tone-${tone}`]} id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container">
    <div class:list={['section-head', intro ? 'section-head--split' : '']}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={id ? `${id}-title` : undefined}>{title}</h2>
      </div>
      {intro && <p>{intro}</p>}
    </div>
    <ul class:list={['jobs__track', `jobs__track--${items.length}`]} tabindex="0" aria-label="Photos from recent jobs">
      {
        items.map((it, i) => {
          const img = images[it.image];
          return (
            <li class="jobs__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <figure class="jobs__fig zoom">
                <div class="frame jobs__frame">
                  <Picture src={img.src} alt={img.alt} widths={[480, 800]} sizes="(min-width: 900px) 30vw, 78vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" quality={78} />
                </div>
                <figcaption class="jobs__cap">{it.caption ?? img.title}</figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .jobs__track {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    margin-inline: calc(var(--gutter, 20px) * -1);
    padding-inline: var(--gutter, 20px);
    scrollbar-width: thin;
  }
  .jobs__item {
    scroll-snap-align: center;
  }
  .jobs__frame {
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-md);
  }
  .jobs__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jobs__cap {
    margin-top: 0.85rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
  }
  .jobs__cap::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 2px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--orange);
  }
  @media (min-width: 640px) {
    .jobs__track {
      grid-auto-columns: 44%;
    }
  }
  @media (min-width: 900px) {
    .jobs__track {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    .jobs__track--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 820px;
    }
    .jobs__track--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
