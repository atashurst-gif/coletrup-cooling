---
/**
 * Section 4 — Why Coletrup. Four benefits, premium line icons, navy feature band.
 */
import Airflow from './Airflow.astro';

const ticks = [
  'A decade of industry experience',
  'Fully qualified & F-Gas certified',
  'Domestic & commercial expertise',
  'Clear, transparent pricing',
  'Energy-efficient solutions',
  'Reliable fault finding & repairs',
  'Professional, personal service',
  'Ongoing servicing & maintenance',
];
---

<section class="section why tone-navy" id="why" aria-labelledby="why-title">
  <Airflow tone="dark" lines={6} seed={5} intensity={0.8} mask="linear-gradient(180deg, transparent 0%, #000 45%, #000 100%)" />
  <div class="container">
    <div class="why__head">
      <h2 id="why-title">Why choose us?</h2>
    </div>
    <ul class="ticks why__ticks">
      {ticks.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .why {
    overflow: hidden;
  }
  .why :global(.container) {
    position: relative;
  }
  .why__head {
    position: relative;
    max-width: 74ch;
  }
  .why__intro {
    margin-top: 1rem;
  }
  .why__ticks {
    position: relative;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    gap: 0.8rem 1.5rem;
    margin-top: 1.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line-on-navy);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.035);
  }
  .why__sub {
    position: relative;
    margin: 2.5rem 0 1.25rem;
    font-size: var(--fs-h3, 1.5rem);
  }
  .why__grid {
    position: relative;
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .why__item {
    padding: 1.75rem;
    border: 1px solid var(--line-on-navy);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.035);
    transition:
      background-color 0.3s ease,
      transform 0.35s var(--ease);
  }
  .why__item:hover {
    background: rgba(255, 255, 255, 0.07);
    transform: translateY(-3px);
  }
  .why__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 1.25rem;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(0, 154, 224, 0.28), rgba(0, 154, 224, 0.08));
    border: 1px solid rgba(91, 196, 242, 0.3);
    color: var(--blue-on-navy);
  }
  .why__title {
    margin-bottom: 0.5rem;
    font-size: 1.1875rem;
  }
  .why__text {
    font-size: var(--fs-sm);
  }
  @media (min-width: 640px) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .why__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
