---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import ImageTextSection from '../components/ImageTextSection.astro';
import BenefitsGrid from '../components/BenefitsGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReviewSection from '../components/ReviewSection.astro';
import AreasSection from '../components/AreasSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import MidCTA from '../components/MidCTA.astro';
import FAQ from '../components/FAQ.astro';
import ManufacturerStrip from '../components/ManufacturerStrip.astro';
import PromoPopup from '../components/PromoPopup.astro';
import { site } from '../lib/site';

const title = 'Air Conditioning & Refrigeration Specialists | Coletrup Cooling';
const description = `Professional air conditioning installation, servicing and repairs for homes ${site.region.phrase}, plus commercial air conditioning and specialist refrigeration repairs and maintenance.`;
const faqs = [
  { q: 'How much does a home AC installation cost?', a: 'The cost depends on the size of the room, the system chosen and the complexity of the installation. We provide a free, no obligation survey to give you an accurate quote for your home.' },
  { q: 'How much does it cost to run?', a: 'Running costs are generally between 10p – 30p per hour, depending on the size of the unit, usage and energy tariff.' },
  { q: 'How long does the installation take?', a: "Most single room installations are completed in 1 day. More complex or multi-room systems may take longer, but we'll always let you know the expected timescale before we start." },
  { q: 'Where can the units be positioned?', a: "Indoor units are wall mounted, usually high on the wall. Outdoor units can be installed on an external wall, ground or roof (depending on your property). We'll advise on the best location during your survey." },
  { q: 'Will it be noisy?', a: "No. Modern systems are very quiet, both inside and out. Indoor units typically run as low as 19–25 dB (quieter than a whisper), so they won't disturb your home." },
  { q: 'Do I need planning permission?', a: "In most cases, no. Standard domestic installations don't usually require planning permission. If you live in a listed building, a conservation area or a flat, it's always best to check with your local council." },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout {title} {description} path="/" ogImage="livingRoomBifold">
  <Hero />

  <ServiceSelector />

  <ImageTextSection
    id="residential"
    tone="white"
    image="openPlanLiving"
    imagePosition="50% 55%"
    imageSide="left"
    eyebrow="Residential air conditioning"
    title="Energy efficient year round comfort for your home."
    body={[
      'At Coletrup Cooling, we believe home comfort should be simple, efficient and tailored to you. Every home is different, which is why we take the time to recommend an air conditioning system that suits your space, lifestyle and budget.',
    ]}
    cta={{ label: 'Get a residential quote', href: '/contact/?service=air-conditioning&type=residential#quote', track: 'residential' }}
    links={[
      { label: 'Air conditioning installation', href: '/air-conditioning-installation/', track: 'installation' },
      { label: 'Air conditioning repairs', href: '/air-conditioning-repairs/', track: 'repair' },
      { label: 'Servicing & maintenance', href: '/air-conditioning-servicing-maintenance/', track: 'maintenance' },
    ]}
    emphasis
  />

  <ManufacturerStrip />

  <BenefitsGrid />

  <ImageTextSection
    id="commercial"
    tone="white"
    image="outdoorTablet"
    imagePosition="60% 40%"
    imageSide="right"
    eyebrow="Commercial air conditioning"
    title="Reliable climate control for your business."
    body={[
      'Professional air conditioning solutions designed to keep your staff, customers and premises comfortable all year round, with installation and maintenance planned to minimise disruption to your business.',
    ]}
    bullets={['Installation', 'Servicing', 'Planned Maintenance', 'Repairs & Fault Finding']}
    chipsLabel="Where we work"
    chips={['Offices', 'Retail', 'Hospitality', 'Warehouses', 'Commercial premises', 'Workspaces']}
    cta={{ label: 'Get a commercial quote', href: '/contact/?service=air-conditioning&type=commercial#quote', track: 'commercial' }}
    links={[
      { label: 'Commercial air conditioning', href: '/commercial-air-conditioning/', track: 'commercial' },
      { label: 'Planned maintenance & service contracts', href: '/planned-maintenance-service-contracts/', track: 'maintenance' },
    ]}
  />

  <MidCTA id="home-mid-cta" tone="white" title="How can we help?" quoteHref="#quote" />

  <ImageTextSection
    id="refrigeration"
    tone="cream"
    image="fridgeGaugesCoat"
    imagePosition="55% 40%"
    imageSide="left"
    eyebrow="Commercial refrigeration"
    title="Keeping your refrigeration equipment efficient and reliable."
    body={[
      'Professional servicing, maintenance, fault finding and repairs to keep your refrigeration equipment performing efficiently and minimise costly downtime.',
    ]}
    bullets={['Servicing', 'Planned Maintenance', 'Fault Finding', 'Repairs']}
    chipsLabel="Equipment we look after"
    chips={['Display Cases', 'Cold Rooms', 'Integral Cabinets', 'Remote Cabinets', 'Commercial Chillers & Freezers']}
    cta={{ label: 'Request refrigeration support', href: '/contact/?service=refrigeration#quote', track: 'refrigeration' }}
    links={[{ label: 'Refrigeration repairs & maintenance', href: '/refrigeration-repairs-maintenance/', track: 'refrigeration' }]}
  />

  <ProcessSteps />

  <ReviewSection />

  <FAQ id="faqs" tone="white" eyebrow="Frequently asked questions" title="Home air conditioning FAQs." intro="Still have questions? Get in touch for a free, no obligation survey and advice tailored to your home." items={faqs} />

  <AreasSection />

  <QuoteForm />

  <PromoPopup />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

</BaseLayout>
