---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Airflow from '../components/Airflow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReviewSection from '../components/ReviewSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import MidCTA from '../components/MidCTA.astro';
import { site } from '../lib/site';

const title = 'About Coletrup Cooling | Air Conditioning & Refrigeration Specialists';
const description =
  'Coletrup Cooling provides professional air conditioning and refrigeration services across Manchester and the North West, for homes and businesses.';
const breadcrumbs = [{ label: 'About Us', href: '/about/' }];
const values = [
  { icon: 'shield', title: 'Professional', text: 'Work carried out properly, with care and attention to detail throughout.' },
  { icon: 'chat', title: 'Responsive', text: 'Clear communication and a straightforward service from first enquiry onwards.' },
  { icon: 'cool', title: 'Experienced', text: 'Industry experience across air conditioning and commercial refrigeration.' },
  { icon: 'gauge', title: 'Technical expertise', text: 'Methodical fault finding, accurate diagnosis and the right solution.' },
  { icon: 'handshake', title: 'Easy to deal with', text: 'Straightforward advice, clear explanations and no unnecessary jargon.' },
];
const quality = [
  { title: 'Expert Installation', text: 'The right system for your space, professionally installed with care.' },
  { title: 'Reliable Repairs', text: 'Accurate fault finding and dependable repairs to get your system back up and running.' },
  { title: 'Ongoing Maintenance', text: 'Regular servicing to maintain efficiency, reliability and long-term performance.' },
  { title: 'Professional Service', text: 'Friendly, professional support from your first enquiry through to completion.' },
];
---

<BaseLayout {title} {description} path="/about/" ogImage="engineerPortrait" {breadcrumbs} stickyPrompt="Need air conditioning or refrigeration support?">
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="About Coletrup Cooling"
    title="Air conditioning & refrigeration specialists."
    lead="Coletrup Cooling provides professional air conditioning and refrigeration services across Manchester and the North West. From air conditioning installation to servicing, fault finding, maintenance and repairs, we provide a reliable service for homes and businesses."
    image="engineerPortrait"
    imagePosition="50% 30%"
    cta={{ label: 'Get a quote', href: '#quote', track: 'quote' }}
    whatsappMessage="Hi Coletrup Cooling, I'd like to find out more about your services."
  />

  <section class="section tone-white about-story" aria-labelledby="story-title">
    <div class="container about-story__grid">
      <div data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 id="story-title">Who we are.</h2>
        <p class="about-story__lead">
          With a decade of industry experience, Coletrup Cooling provides professional air conditioning and refrigeration services for homes and businesses across Manchester and the North West. From installations and maintenance to fault finding and repairs, we're committed to delivering a straightforward, reliable and professional service from start to finish.
        </p>
        <h3 class="about-story__sub">Quality workmanship you can rely on.</h3>
        <dl class="about-story__quality">
          {quality.map((q) => (
            <div>
              <dt>{q.title}</dt>
              <dd>{q.text}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="about-story__media" data-reveal style="--reveal-delay:120ms">
        <div class="frame about-story__frame about-story__panel" role="img" aria-label="Keeping it cool">
          <Airflow tone="dark" lines={7} seed={57} intensity={0.85} />
          <img class="about-story__mark" src="/brand/keeping-it-cool.webp" alt="" width="900" height="784" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section tone-navy about-values" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How we work</p>
          <h2 id="values-title">What you can expect from us.</h2>
        </div>
        <p>Whether it's air conditioning for your home or ongoing refrigeration support for your business, you can expect the same professional approach.</p>
      </div>
      <ul class="about-values__grid">
        {
          values.map((v, i) => (
            <li class="about-values__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="icon-badge"><Icon name={v.icon} /></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section tone-cream about-what" aria-labelledby="what-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">What we do</p>
        <h2 id="what-title">Air conditioning & refrigeration services for homes and businesses.</h2>
      </div>
      <div class="about-what__grid">
        <a href="/residential-air-conditioning/" class="card card--lift about-what__card" data-track="cta" data-cta="residential" data-location="about">
          <h3>Residential air conditioning</h3>
          <p>Installation, servicing and repairs for homes — including bedrooms, living spaces, home offices, extensions and multi-room systems.</p>
          <span class="link-arrow"><span>Explore residential</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
        <a href="/commercial-air-conditioning/" class="card card--lift about-what__card" data-track="cta" data-cta="commercial" data-location="about">
          <h3>Commercial air conditioning</h3>
          <p>Installation, servicing, maintenance and repairs for offices, retail, hospitality, warehouses and other commercial premises.</p>
          <span class="link-arrow"><span>Explore commercial</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
        <a href="/refrigeration-repairs-maintenance/" class="card card--lift about-what__card" data-track="cta" data-cta="refrigeration" data-location="about">
          <h3>Refrigeration</h3>
          <p>Servicing, maintenance, fault finding and repairs for commercial refrigeration, including fridges, freezers, display refrigeration, cold rooms and cellar cooling.</p>
          <span class="link-arrow"><span>Explore refrigeration</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
      </div>
    </div>
  </section>

  <MidCTA id="about-mid-cta" tone="cream" quoteHref="#quote" title="Let's get started." text="Tell us what you need and we'll take it from there." whatsappMessage="Hi Coletrup Cooling, I'd like to find out more about your services." />

  <ProcessSteps
    tone="white"
    title="From enquiry to completion."
    steps={[
      { title: 'Get in touch', text: "Tell us what you need, whether it's an installation, service, maintenance or repair." },
      { title: 'We assess your requirements', text: "We take the time to understand the job and what's required." },
      { title: 'We provide the right solution', text: 'Clear advice on the work required, with everything explained upfront.' },
      { title: 'We complete the work', text: 'Work carried out professionally and with care from start to finish.' },
    ]}
  />

  <ReviewSection image="graphicDeepWave" />

  <QuoteForm id="quote" />

  <FinalCTA title="Need air conditioning or refrigeration support?" />
</BaseLayout>

<style>
  .about-story__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .about-story__frame {
    aspect-ratio: 4 / 3;
  }
  /* Animated "Keeping It Cool" panel (same as the service pages) */
  .about-story__panel {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(0, 154, 224, 0.3), transparent 60%),
      radial-gradient(60% 100% at 0% 100%, rgba(245, 117, 0, 0.2), transparent 60%),
      linear-gradient(135deg, var(--navy-700), var(--navy-900));
  }
  .about-story__panel img.about-story__mark {
    position: relative;
    width: min(58%, 340px);
    height: auto;
    object-fit: contain;
    transform: rotate(-2deg);
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.25));
  }
  .about-story__lead {
    margin-top: 1rem;
  }
  .about-story__sub {
    margin: 1.75rem 0 1rem;
  }
  .about-story__quality {
    display: grid;
    gap: 0.9rem 1.5rem;
    margin: 0 0 1.5rem;
  }
  .about-story__quality div {
    padding-left: 1rem;
    border-left: 3px solid var(--blue);
  }
  .about-story__quality dt {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
  }
  .about-story__quality dd {
    margin: 0.15rem 0 0;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .about-story__quality {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .about-values__grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .about-values__item {
    padding: 1.5rem;
    border: 1px solid var(--line-on-navy);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.035);
  }
  .about-values__item h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.0625rem;
  }
  .about-values__item p {
    font-size: var(--fs-sm);
  }
  .about-what__grid {
    display: grid;
    gap: 1.25rem;
  }
  .about-what__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
  }
  .about-what__card h3 {
    font-size: 1.3rem;
  }
  .about-what__card p {
    color: var(--muted);
  }
  .about-what__card .link-arrow {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .about-what__card--main {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .about-what__card--main h3 {
    color: #fff;
    font-size: 1.6rem;
  }
  .about-what__card--main p {
    color: var(--on-navy-muted);
  }
  .about-what__card--main .link-arrow {
    color: #fff;
  }
  .about-what__card--main .link-arrow svg {
    color: var(--orange-on-navy);
  }
  .about-what__tag {
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--orange);
    color: var(--navy);
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (min-width: 640px) {
    .about-values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-what__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-what__card--main {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .about-story__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
    .about-values__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .about-what__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .about-what__card--main {
      grid-column: auto;
    }
  }
</style>
