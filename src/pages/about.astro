---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReviewSection from '../components/ReviewSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import MidCTA from '../components/MidCTA.astro';
import { images } from '../lib/images';
import { site } from '../lib/site';

const title = 'About Coletrup Cooling | Air Conditioning Specialists';
const description =
  'Coletrup Cooling is a specialist air conditioning company providing installation, servicing and repairs for homes and businesses, plus refrigeration servicing, maintenance and repairs.';
const breadcrumbs = [{ label: 'About', href: '/about/' }];
const values = [
  { icon: 'shield', title: 'Professional', text: 'Work carried out properly, with care for your home or premises.' },
  { icon: 'chat', title: 'Responsive', text: 'Easy to reach and clear about what happens next.' },
  { icon: 'cool', title: 'Specialist', text: 'Focused on air conditioning, with refrigeration expertise alongside.' },
  { icon: 'gauge', title: 'Technically capable', text: 'Methodical diagnosis and the right solution, not guesswork.' },
  { icon: 'handshake', title: 'Easy to deal with', text: 'Plain-English advice from first enquiry to finished job.' },
];
const gauges = images.engineerGauges;
---

<BaseLayout {title} {description} path="/about/" ogImage="engineerFilterClean" {breadcrumbs}>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="About Coletrup Cooling"
    title="Specialists in keeping homes and businesses cool."
    lead="Coletrup Cooling provides professional air conditioning installation, servicing and repairs for homes and businesses, alongside specialist refrigeration servicing, maintenance and repairs."
    image="engineerFilterClean"
    imagePosition="50% 45%"
    cta={{ label: 'Get a quote', href: '#quote', track: 'quote' }}
    whatsappMessage="Hi Coletrup Cooling, I'd like to find out more about your services."
  />

  <section class="section tone-white about-story" aria-labelledby="story-title">
    <div class="container about-story__grid">
      <div data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 id="story-title">Who we are.</h2>
        <Placeholder block label="COMPANY BACKGROUND TO BE SUPPLIED" class="about-story__ph">
          <p>
            Insert verified company information here: who founded Coletrup Cooling, the team, and how the business came to specialise in air conditioning and refrigeration.
            Do not add years trading, customer numbers, accreditations or manufacturer relationships unless verified.
          </p>
        </Placeholder>
        <Placeholder block label="TEAM / FOUNDER PROFILE TO BE SUPPLIED" class="about-story__ph">
          <p>Name, role and a short verified bio. A photo can be added alongside.</p>
        </Placeholder>
      </div>
      <div class="about-story__media" data-reveal style="--reveal-delay:120ms">
        <div class="frame about-story__frame zoom">
          <Picture src={gauges.src} alt={gauges.alt} title={gauges.title} widths={[480, 800, 1200]} sizes="(min-width: 1080px) 40vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" fallbackFormat="webp" loading="lazy" decoding="async" quality={80} style="object-position:50% 35%" />
        </div>
      </div>
    </div>
  </section>

  <section class="section tone-navy about-values" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How we work</p>
          <h2 id="values-title">What you can expect from us.</h2>
        </div>
        <p>Whether it's a single-room installation at home or planned maintenance across a business, the approach is the same.</p>
      </div>
      <ul class="about-values__grid">
        {
          values.map((v, i) => (
            <li class="about-values__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="icon-badge"><Icon name={v.icon} /></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section tone-cream about-what" aria-labelledby="what-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">What we do</p>
        <h2 id="what-title">Air conditioning first. Refrigeration expertise alongside.</h2>
      </div>
      <div class="about-what__grid">
        <a href="/residential-air-conditioning/" class="card card--lift about-what__card about-what__card--main" data-track="cta" data-cta="residential" data-location="about">
          <span class="about-what__tag">Our main focus</span>
          <h3>Residential air conditioning</h3>
          <p>Installation, servicing and repairs for homes — bedrooms, living rooms, home offices, extensions, open-plan spaces and multiple rooms.</p>
          <span class="link-arrow"><span>Explore residential</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
        <a href="/commercial-air-conditioning/" class="card card--lift about-what__card" data-track="cta" data-cta="commercial" data-location="about">
          <h3>Commercial air conditioning</h3>
          <p>Installation, servicing, maintenance and repairs for offices, retail, hospitality, warehouses and workspaces.</p>
          <span class="link-arrow"><span>Explore commercial</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
        <a href="/refrigeration-repairs-maintenance/" class="card card--lift about-what__card" data-track="cta" data-cta="refrigeration" data-location="about">
          <h3>Refrigeration</h3>
          <p>Specialist servicing, maintenance, fault finding and repairs for fridges, freezers, display fridges and cold rooms.</p>
          <span class="link-arrow"><span>Explore refrigeration</span><Icon name="arrow" strokeWidth={2} /></span>
        </a>
      </div>
    </div>
  </section>

  <MidCTA id="about-mid-cta" tone="cream" quoteHref="#quote" whatsappMessage="Hi Coletrup Cooling, I'd like to find out more about your services." />

  <ProcessSteps tone="white" />

  <ReviewSection />

  <QuoteForm id="quote" />

  <FinalCTA />
</BaseLayout>

<style>
  .about-story__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .about-story__ph {
    margin-top: 1.25rem;
  }
  .about-story__frame {
    aspect-ratio: 4 / 3;
  }
  .about-story__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-values__grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .about-values__item {
    padding: 1.5rem;
    border: 1px solid var(--line-on-navy);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.035);
  }
  .about-values__item h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.0625rem;
  }
  .about-values__item p {
    font-size: var(--fs-sm);
  }
  .about-what__grid {
    display: grid;
    gap: 1.25rem;
  }
  .about-what__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
  }
  .about-what__card h3 {
    font-size: 1.3rem;
  }
  .about-what__card p {
    color: var(--muted);
  }
  .about-what__card .link-arrow {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .about-what__card--main {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .about-what__card--main h3 {
    color: #fff;
    font-size: 1.6rem;
  }
  .about-what__card--main p {
    color: var(--on-navy-muted);
  }
  .about-what__card--main .link-arrow {
    color: #fff;
  }
  .about-what__card--main .link-arrow svg {
    color: var(--orange-on-navy);
  }
  .about-what__tag {
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--orange);
    color: var(--navy);
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (min-width: 640px) {
    .about-values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-what__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-what__card--main {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .about-story__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
    .about-values__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .about-what__grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
    .about-what__card--main {
      grid-column: auto;
    }
  }
</style>
