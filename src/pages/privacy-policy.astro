---
import LegalLayout from '../layouts/LegalLayout.astro';
import { site } from '../lib/site';
const name = site.company.registeredName || site.name;
const an = site.analytics;
const analyticsOn = [(an.gtmId || an.ga4Id) && 'Google Analytics', an.metaPixelId && 'Meta', an.googleAdsId && 'Google Ads'].filter(Boolean);
---

<LegalLayout title="Privacy Policy | Coletrup Cooling" pageTitle="Privacy Policy" description="How Coletrup Cooling collects, uses and protects your personal information." path="/privacy-policy/">
  <h2>Who we are</h2>
  <p>
    This website is operated by {name}{site.company.companyNumber ? ` (company number ${site.company.companyNumber})` : ''}{site.company.registeredOffice ? `, registered office ${site.company.registeredOffice}` : ''}. We are the data controller for the personal information collected through this site.
  </p>
  {site.contact.email && <p>Contact for privacy matters: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>}

  <h2>What we collect and why</h2>
  <ul>
    <li><strong>Quote and contact enquiries</strong> — name, phone number, email address, postcode and the service you are interested in, so we can respond to your enquiry and provide a quote. Lawful basis: taking steps at your request before entering into a contract.</li>
    <li><strong>Enquiry reference and attribution</strong> — a reference number, the page you enquired from and, where present, campaign parameters (such as UTM tags) so we can understand which channels our enquiries come from. Lawful basis: legitimate interests.</li>
    <li><strong>WhatsApp and phone contact</strong> — if you message or call us, we process the details you provide to respond to you.</li>
    <li><strong>Analytics cookies</strong> — only with your consent (see our <a href="/cookie-policy/">cookie policy</a>).</li>
  </ul>

  <h2>Who we share it with</h2>
  <p>
    {site.forms.provider === 'netlify' ? 'Enquiries sent through the quote form are delivered to us by the form service of our website host (Netlify).' : 'Enquiries sent through the quote form are delivered to us by a form processing service.'}
    {' '}Analytics and advertising measurement providers are only used if you accept cookies{analyticsOn.length ? ` (${analyticsOn.join(', ')})` : ''}. We do not sell your personal information.
  </p>

  <h2>How long we keep it</h2>
  <p>Enquiry details are kept only for as long as they are needed to deal with your enquiry. If you become a customer, they are kept as part of your customer records.</p>

  <h2>Your rights</h2>
  <p>Under UK GDPR you have the right to access, correct, erase, restrict or object to our processing of your personal information, and to data portability. To exercise these rights contact us at the email address above. You can also complain to the Information Commissioner's Office (ico.org.uk).</p>

  <h2>Changes</h2>
  <p>We may update this policy from time to time.</p>
</LegalLayout>
