---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Airflow from '../components/Airflow.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site, hasPhone, hasWhatsApp, hasEmail, hasCompanyDetails, telHref, whatsappHref } from '../lib/site';

// Only the contact routes that have been supplied are shown (nothing is left as a placeholder).
const routes = [hasWhatsApp && 'WhatsApp', hasPhone && 'phone', hasEmail && 'email'].filter(Boolean) as string[];
const routesText = routes.length > 1 ? `${routes.slice(0, -1).join(', ')} or ${routes[routes.length - 1]}` : routes[0];
const title = 'Contact & Get a Quote | Coletrup Cooling';
const description = `Request a free air conditioning or refrigeration quote from Coletrup Cooling in four quick steps${routesText ? `, or get in touch by ${routesText}` : ''}.`;
const breadcrumbs = [{ label: 'Contact & Get a Quote', href: '/contact/' }];
---

<BaseLayout {title} {description} path="/contact/" ogImage="engineerHomeDark" {breadcrumbs} stickyPrompt="Need air conditioning or refrigeration support?">
  <section class="contact-hero">
    <Airflow tone="light" lines={6} seed={17} intensity={0.8} mask="linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.3) 40%, #000 65%, #000 100%)" />
    <div class="container contact-hero__inner">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow contact-hero__eyebrow">Contact</p>
      <h1 class="contact-hero__title">Let's talk about what you need.</h1>
      <p class="contact-hero__lead">
        Whether you need air conditioning installation, or servicing, maintenance or repairs for air conditioning or refrigeration, get in touch and tell us what you need. Complete the short form below{routesText ? `, or contact us by ${routesText}` : ''}.
      </p>
      {routes.length > 0 && (
      <ul class:list={['contact-hero__cards', `contact-hero__cards--${routes.length}`]}>
        {hasWhatsApp && (
        <li class="card contact-card" id="whatsapp">
          <span class="icon-badge"><Icon name="chat" /></span>
          <div>
            <h2>WhatsApp</h2>
            <a href={whatsappHref()} target="_blank" rel="noopener" class="contact-card__link" data-track="cta" data-cta="whatsapp" data-location="contact-page">
              Message us on WhatsApp
            </a>
            <p>Send us a message, photos or details of your enquiry and we'll take it from there.</p>
          </div>
        </li>
        )}
        {hasPhone && (
        <li class="card contact-card" id="call">
          <span class="icon-badge"><Icon name="phone" /></span>
          <div>
            <h2>Phone</h2>
            <a href={telHref} class="contact-card__link" data-track="cta" data-cta="phone" data-location="contact-page">{site.contact.phoneDisplay}</a>
            {site.contact.openingHours.length > 0 && <p>{site.contact.openingHours.join(' · ')}</p>}
          </div>
        </li>
        )}
        {hasEmail && (
        <li class="card contact-card" id="email">
          <span class="icon-badge"><Icon name="mail" /></span>
          <div>
            <h2>Email</h2>
            <a href={`mailto:${site.contact.email}`} class="contact-card__link">{site.contact.email}</a>
            <p>For quotes, maintenance enquiries and anything else.</p>
          </div>
        </li>
        )}
      </ul>
      )}
    </div>
  </section>

  <QuoteForm id="quote" tone="navy" />

  <section class="section tone-cream contact-info" aria-labelledby="info-title">
    <div class="container contact-info__grid">
      <div>
        <p class="eyebrow">What happens next</p>
        <h2 id="info-title">Straightforward from the start.</h2>
        <ol class="contact-info__steps">
          <li><strong>Send us your enquiry</strong><span>Tell us what you need and provide any useful details or photos.</span></li>
          <li><strong>We discuss your requirements</strong><span>We'll get in touch to understand the job and what's required.</span></li>
          <li><strong>We provide the right solution</strong><span>We'll explain the recommended approach and provide a clear quote.</span></li>
          <li><strong>We carry out the work</strong><span>Once agreed, the work is completed professionally and with care.</span></li>
        </ol>
      </div>
      <div class="contact-info__aside">
        <h3>{hasCompanyDetails ? 'Company details' : 'Contact details'}</h3>
        <dl class="contact-info__dl">
          {site.company.registeredName && (<><dt>Company</dt><dd>{site.company.registeredName}</dd></>)}
          {site.company.companyNumber && (<><dt>Company no.</dt><dd>{site.company.companyNumber}</dd></>)}
          {site.company.registeredOffice && (<><dt>Registered office</dt><dd>{site.company.registeredOffice}</dd></>)}
          {hasEmail && (<><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></>)}
          <dt>Service area</dt>
          <dd>{site.region.name} <a href="/areas-we-cover/">(areas we cover)</a></dd>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(20px, 3vw, 36px) 0 clamp(48px, 6vw, 72px);
    background:
      radial-gradient(50% 50% at 90% 0%, rgba(0, 154, 224, 0.1), transparent 70%),
      var(--cream);
  }
  .contact-hero__inner {
    position: relative;
  }
  .contact-hero__eyebrow {
    margin-top: 1.5rem;
  }
  .contact-hero__title {
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
  }
  .contact-hero__lead {
    margin-top: 1.1rem;
    max-width: 58ch;
    font-size: var(--fs-lead);
  }
  .contact-hero__cards {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-card {
    display: flex;
    gap: 1rem;
    padding: 1.4rem;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .contact-card h2 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .contact-card__link {
    display: inline-block;
    margin-bottom: 0.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
  }
  .contact-card__link:hover {
    text-decoration: underline;
  }
  .contact-card p {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .contact-info__grid {
    display: grid;
    gap: 3rem;
  }
  .contact-info__steps {
    list-style: none;
    counter-reset: c;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 52ch;
  }
  .contact-info__steps li {
    counter-increment: c;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0.25rem 1rem;
    align-items: start;
  }
  .contact-info__steps li::before {
    content: counter(c, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--blue-ink);
    line-height: 1.2;
  }
  .contact-info__steps strong {
    font-family: var(--font-head);
    color: var(--navy);
  }
  .contact-info__steps span {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .contact-info__aside {
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    align-self: start;
  }
  .contact-info__aside h3 {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .contact-info__dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.25rem;
    margin: 0;
    font-size: var(--fs-sm);
  }
  .contact-info__dl dt {
    font-weight: 700;
    color: var(--navy);
  }
  .contact-info__dl dd {
    margin: 0;
    color: var(--muted);
  }
  .contact-info__dl a {
    color: var(--navy);
  }
  @media (min-width: 760px) {
    .contact-hero__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Fewer contact routes: cards keep a sensible width rather than stretching */
    .contact-hero__cards--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 820px;
    }
    .contact-hero__cards--1 {
      grid-template-columns: minmax(0, 1fr);
      max-width: 440px;
    }
  }
  @media (min-width: 1080px) {
    .contact-info__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
  }
</style>

<script>
  // Preselect form options from ?service=…&type=… (used by CTAs across the site)
  const params = new URLSearchParams(location.search);
  const pick = (name: string, value: string | null) => {
    if (!value) return;
    const input = document.querySelector<HTMLInputElement>(`form[data-quote-form] input[name="${name}"][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;
  };
  pick('service', params.get('service'));
  pick('customer_type', params.get('type'));
</script>
