---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Airflow from '../components/Airflow.astro';
import Placeholder from '../components/Placeholder.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site, hasPhone, hasWhatsApp, hasEmail, telHref, whatsappHref } from '../lib/site';

const title = 'Contact & Get a Quote | Coletrup Cooling';
const description =
  'Request a free air conditioning or refrigeration quote from Coletrup Cooling in four quick steps, or get in touch by WhatsApp, phone or email.';
const breadcrumbs = [{ label: 'Contact & Get a Quote', href: '/contact/' }];
---

<BaseLayout {title} {description} path="/contact/" ogImage="engineerHomeDark" {breadcrumbs}>
  <section class="contact-hero">
    <Airflow tone="light" lines={6} seed={17} intensity={0.8} mask="linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.3) 40%, #000 65%, #000 100%)" />
    <div class="container contact-hero__inner">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow contact-hero__eyebrow">Contact</p>
      <h1 class="contact-hero__title">Get in touch. Get a quote.</h1>
      <p class="contact-hero__lead">
        The quickest way to get a quote is the short form below. Prefer to talk? WhatsApp, call or email us and we'll take it from there.
      </p>
      <ul class="contact-hero__cards">
        <li class="card contact-card" id="whatsapp">
          <span class="icon-badge"><Icon name="chat" /></span>
          <div>
            <h2>WhatsApp</h2>
            {
              hasWhatsApp ? (
                <a href={whatsappHref()} target="_blank" rel="noopener" class="contact-card__link" data-track="cta" data-cta="whatsapp" data-location="contact-page">
                  Message us on WhatsApp
                </a>
              ) : (
                <Placeholder label="WHATSAPP NUMBER TO BE ADDED" />
              )
            }
            <p>Send photos of your system or the fault to help us understand the job.</p>
          </div>
        </li>
        <li class="card contact-card" id="call">
          <span class="icon-badge"><Icon name="phone" /></span>
          <div>
            <h2>Phone</h2>
            {
              hasPhone ? (
                <a href={telHref} class="contact-card__link" data-track="cta" data-cta="phone" data-location="contact-page">{site.contact.phoneDisplay}</a>
              ) : (
                <Placeholder label="PHONE NUMBER TO BE ADDED" />
              )
            }
            <p>{site.contact.openingHours.length ? site.contact.openingHours.join(' · ') : <Placeholder label="OPENING HOURS TO BE ADDED" />}</p>
          </div>
        </li>
        <li class="card contact-card" id="email">
          <span class="icon-badge"><Icon name="mail" /></span>
          <div>
            <h2>Email</h2>
            {hasEmail ? <a href={`mailto:${site.contact.email}`} class="contact-card__link">{site.contact.email}</a> : <Placeholder label="EMAIL ADDRESS TO BE ADDED" />}
            <p>For quotes, maintenance enquiries and anything else.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <QuoteForm id="quote" tone="navy" />

  <section class="section tone-cream contact-info" aria-labelledby="info-title">
    <div class="container contact-info__grid">
      <div>
        <p class="eyebrow">What happens next</p>
        <h2 id="info-title">Simple, from the first message.</h2>
        <ol class="contact-info__steps">
          <li><strong>We receive your enquiry</strong><span>You'll get a reference number straight away.</span></li>
          <li><strong>We talk it through</strong><span>We'll get in touch to understand your space and what you need.</span></li>
          <li><strong>We recommend the right service</strong><span>Clear advice on the right approach for your home or business.</span></li>
          <li><strong>We complete the work</strong><span>Carried out professionally, with care, from start to finish.</span></li>
        </ol>
      </div>
      <div class="contact-info__aside">
        <h3>Company details</h3>
        <dl class="contact-info__dl">
          <dt>Company</dt>
          <dd>{site.company.registeredName || <Placeholder label="REGISTERED NAME" />}</dd>
          <dt>Company no.</dt>
          <dd>{site.company.companyNumber || <Placeholder label="COMPANY NUMBER" />}</dd>
          <dt>Registered office</dt>
          <dd>{site.company.registeredOffice || <Placeholder label="REGISTERED OFFICE" />}</dd>
          <dt>Service area</dt>
          <dd>{site.region.name} <a href="/areas-we-cover/">(areas we cover)</a></dd>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(20px, 3vw, 36px) 0 clamp(48px, 6vw, 72px);
    background:
      radial-gradient(50% 50% at 90% 0%, rgba(0, 154, 224, 0.1), transparent 70%),
      var(--cream);
  }
  .contact-hero__inner {
    position: relative;
  }
  .contact-hero__eyebrow {
    margin-top: 1.5rem;
  }
  .contact-hero__title {
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
  }
  .contact-hero__lead {
    margin-top: 1.1rem;
    max-width: 58ch;
    font-size: var(--fs-lead);
  }
  .contact-hero__cards {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-card {
    display: flex;
    gap: 1rem;
    padding: 1.4rem;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .contact-card h2 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .contact-card__link {
    display: inline-block;
    margin-bottom: 0.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
  }
  .contact-card__link:hover {
    text-decoration: underline;
  }
  .contact-card p {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .contact-info__grid {
    display: grid;
    gap: 3rem;
  }
  .contact-info__steps {
    list-style: none;
    counter-reset: c;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 52ch;
  }
  .contact-info__steps li {
    counter-increment: c;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0.25rem 1rem;
    align-items: start;
  }
  .contact-info__steps li::before {
    content: counter(c, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--blue-ink);
    line-height: 1.2;
  }
  .contact-info__steps strong {
    font-family: var(--font-head);
    color: var(--navy);
  }
  .contact-info__steps span {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .contact-info__aside {
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    align-self: start;
  }
  .contact-info__aside h3 {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .contact-info__dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.25rem;
    margin: 0;
    font-size: var(--fs-sm);
  }
  .contact-info__dl dt {
    font-weight: 700;
    color: var(--navy);
  }
  .contact-info__dl dd {
    margin: 0;
    color: var(--muted);
  }
  .contact-info__dl a {
    color: var(--navy);
  }
  @media (min-width: 760px) {
    .contact-hero__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .contact-info__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
  }
</style>

<script>
  // Preselect form options from ?service=…&type=… (used by CTAs across the site)
  const params = new URLSearchParams(location.search);
  const pick = (name: string, value: string | null) => {
    if (!value) return;
    const input = document.querySelector<HTMLInputElement>(`form[data-quote-form] input[name="${name}"][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;
  };
  pick('service', params.get('service'));
  pick('customer_type', params.get('type'));
</script>
