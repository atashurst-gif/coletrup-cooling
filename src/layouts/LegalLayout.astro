---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  pageTitle: string;
  description: string;
  path: string;
  updated?: string;
}
// NOTE (5 Oct 2026): the legal pages are still drafts. Company details, retention periods and
// any ICO number are left out until supplied — complete and review them before launch.
const { title, pageTitle, description, path, updated } = Astro.props;
const breadcrumbs = [{ label: pageTitle, href: path }];
---

<BaseLayout {title} {description} {path} noindex {breadcrumbs}>
  <section class="legal">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="legal__title">{pageTitle}</h1>
      {updated && <p class="legal__meta">Last updated: {updated}</p>}
      <div class="prose legal__prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding: clamp(20px, 3vw, 36px) 0 var(--section-y);
  }
  .legal__title {
    margin-top: 1.5rem;
    font-size: var(--fs-h1);
  }
  .legal__meta {
    margin: 0.75rem 0 1.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .legal__notice {
    margin-bottom: 2rem;
    max-width: 72ch;
  }
  .legal__prose :global(p),
  .legal__prose :global(li) {
    color: var(--charcoal);
  }
</style>
